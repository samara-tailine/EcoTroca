// EcoTroca initial data model.
// Snapshot fields preserve the values selected when a disposal request is created.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DisposalStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum EcoCoinMovementType {
  CREDIT
  DEBIT
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  name                   String              @db.VarChar(160)
  email                  String              @unique @db.VarChar(320)
  passwordHash           String?             @db.VarChar(255)
  studentIdentifier      String?             @unique @db.VarChar(64)
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(6)
  accessProfiles         UserAccessProfile[] @relation("ProfileAssignment")
  assignmentsCreated    UserAccessProfile[] @relation("ProfileAssignmentActor")
  wallet                 EcoCoinWallet?
  disposalRequests       DisposalRequest[]   @relation("DisposalRequester")
  reviewedDisposals      DisposalRequest[]   @relation("DisposalReviewer")
  createdEcoCoinMovements EcoCoinMovement[]  @relation("MovementCreatedBy")
  createdSettings        SystemSetting[]     @relation("SettingCreatedBy")
  updatedSettings        SystemSetting[]     @relation("SettingUpdatedBy")

  @@index([isActive, name])
}

model AccessProfile {
  id          String              @id @default(uuid()) @db.Uuid
  key         String              @unique @db.VarChar(50)
  name        String              @db.VarChar(100)
  description String?             @db.VarChar(500)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  assignments UserAccessProfile[]
}

model UserAccessProfile {
  userId             String        @db.Uuid
  accessProfileId    String        @db.Uuid
  assignedByUserId   String?       @db.Uuid
  assignedAt         DateTime      @default(now()) @db.Timestamptz(6)
  user               User          @relation("ProfileAssignment", fields: [userId], references: [id], onDelete: Cascade)
  accessProfile      AccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Restrict)
  assignedBy         User?         @relation("ProfileAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, accessProfileId])
  @@index([accessProfileId])
  @@index([assignedByUserId])
}

model Category {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique @db.VarChar(120)
  description String?     @db.VarChar(500)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  equipment   Equipment[]
}

model Equipment {
  id                    String         @id @default(uuid()) @db.Uuid
  categoryId            String         @db.Uuid
  name                  String         @db.VarChar(160)
  description           String?        @db.VarChar(500)
  averageWeightGrams    Int
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(6)
  category              Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  disposalItems         DisposalItem[]

  @@unique([categoryId, name])
  @@index([categoryId, isActive])
}

model DisposalRequest {
  id                               String                 @id @default(uuid()) @db.Uuid
  requesterId                      String                 @db.Uuid
  status                            DisposalStatus         @default(PENDING)
  conversionRateCoinsPerKgSnapshot Decimal                @db.Decimal(12, 4)
  requestedAt                      DateTime               @default(now()) @db.Timestamptz(6)
  reviewedAt                       DateTime?              @db.Timestamptz(6)
  approvedAt                       DateTime?              @db.Timestamptz(6)
  reviewedById                     String?                @db.Uuid
  reviewNotes                      String?                @db.Text
  createdAt                        DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                        DateTime               @updatedAt @db.Timestamptz(6)
  requester                         User                   @relation("DisposalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewedBy                        User?                  @relation("DisposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  items                             DisposalItem[]
  ecoCoinMovement                   EcoCoinMovement?

  @@index([requesterId, status, requestedAt])
  @@index([status, requestedAt])
  @@index([reviewedById])
}

model DisposalItem {
  id                              String         @id @default(uuid()) @db.Uuid
  disposalRequestId               String         @db.Uuid
  equipmentId                     String         @db.Uuid
  quantity                        Int
  averageWeightGramsSnapshot      Int
  createdAt                       DateTime       @default(now()) @db.Timestamptz(6)
  disposalRequest                 DisposalRequest @relation(fields: [disposalRequestId], references: [id], onDelete: Restrict)
  equipment                       Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([disposalRequestId, equipmentId])
  @@index([equipmentId])
}

model EcoCoinWallet {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @unique @db.Uuid
  balance     Decimal            @default(0) @db.Decimal(14, 4)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  movements   EcoCoinMovement[]
}

model EcoCoinMovement {
  id               String                @id @default(uuid()) @db.Uuid
  walletId         String                @db.Uuid
  type             EcoCoinMovementType
  amount           Decimal               @db.Decimal(14, 4)
  balanceAfter     Decimal               @db.Decimal(14, 4)
  disposalRequestId String?              @unique @db.Uuid
  createdByUserId  String?               @db.Uuid
  description      String?               @db.VarChar(500)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  wallet           EcoCoinWallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  disposalRequest  DisposalRequest?      @relation(fields: [disposalRequestId], references: [id], onDelete: Restrict)
  createdBy        User?                 @relation("MovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([createdByUserId, createdAt])
}

model SystemSetting {
  id               String    @id @default(uuid()) @db.Uuid
  key              String    @unique @db.VarChar(120)
  value            Json      @db.JsonB
  description      String?   @db.VarChar(500)
  createdByUserId  String?   @db.Uuid
  updatedByUserId  String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  createdBy        User?     @relation("SettingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy        User?     @relation("SettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}

