// EcoTroca initial data model.
// Snapshot fields preserve the values selected when a disposal request is created.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DisposalStatus {
  PENDING
  RECEIVED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum EcoCoinMovementType {
  CREDIT
  DEBIT
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  name                   String              @db.VarChar(160)
  email                  String              @unique @db.VarChar(320)
  passwordHash           String?             @db.VarChar(255)
  studentIdentifier      String?             @unique @db.VarChar(64)
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(6)
  accessProfiles         UserAccessProfile[] @relation("ProfileAssignment")
  assignmentsCreated    UserAccessProfile[] @relation("ProfileAssignmentActor")
  paymentsSent           EcoCoinPayment[] @relation("PaymentStudent")
  paymentsReceived       EcoCoinPayment[] @relation("PaymentRecipient")
  wallet                 EcoCoinWallet?
  disposalRequests       DisposalRequest[]   @relation("DisposalRequester")
  reviewedDisposals      DisposalRequest[]   @relation("DisposalReviewer")
  disposalStatusHistory  DisposalStatusHistory[] @relation("DisposalHistoryActor")
  disposalItemDivergences DisposalItemDivergence[] @relation("DisposalDivergenceActor")
  createdEcoCoinMovements EcoCoinMovement[]  @relation("MovementCreatedBy")
  createdSettings        SystemSetting[]     @relation("SettingCreatedBy")
  updatedSettings        SystemSetting[]     @relation("SettingUpdatedBy")

  @@index([isActive, name])
}

model AccessProfile {
  id          String              @id @default(uuid()) @db.Uuid
  key         String              @unique @db.VarChar(50)
  name        String              @db.VarChar(100)
  description String?             @db.VarChar(500)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
  assignments UserAccessProfile[]
}

model UserAccessProfile {
  userId             String        @db.Uuid
  accessProfileId    String        @db.Uuid
  assignedByUserId   String?       @db.Uuid
  assignedAt         DateTime      @default(now()) @db.Timestamptz(6)
  user               User          @relation("ProfileAssignment", fields: [userId], references: [id], onDelete: Cascade)
  accessProfile      AccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Restrict)
  assignedBy         User?         @relation("ProfileAssignmentActor", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, accessProfileId])
  @@index([accessProfileId])
  @@index([assignedByUserId])
}

model Category {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique @db.VarChar(120)
  description String?     @db.VarChar(500)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  equipment   Equipment[]
}

model Equipment {
  id                    String         @id @default(uuid()) @db.Uuid
  categoryId            String         @db.Uuid
  name                  String         @db.VarChar(160)
  description           String?        @db.VarChar(500)
  officialCatalogKey    String?        @unique @db.VarChar(50)
  averageWeightGrams    Int
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(6)
  category              Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  disposalItems         DisposalItem[]

  @@unique([categoryId, name])
  @@index([categoryId, isActive])
}

model DisposalRequest {
  id                               String                 @id @default(uuid()) @db.Uuid
  requesterId                      String                 @db.Uuid
  status                            DisposalStatus         @default(PENDING)
  conversionRateCoinsPerKgSnapshot Decimal?               @db.Decimal(12, 4)
  totalWeightGramsSnapshot         Int?
  receivedAt                       DateTime?              @db.Timestamptz(6)
  checkedAt                        DateTime?              @db.Timestamptz(6)
  requestedAt                      DateTime               @default(now()) @db.Timestamptz(6)
  reviewedAt                       DateTime?              @db.Timestamptz(6)
  approvedAt                       DateTime?              @db.Timestamptz(6)
  reviewedById                     String?                @db.Uuid
  reviewNotes                      String?                @db.Text
  createdAt                        DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                        DateTime               @updatedAt @db.Timestamptz(6)
  requester                         User                   @relation("DisposalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewedBy                        User?                  @relation("DisposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  items                             DisposalItem[]
  ecoCoinMovement                   EcoCoinMovement?
  statusHistory                     DisposalStatusHistory[]

  @@index([requesterId, status, requestedAt])
  @@index([status, requestedAt])
  @@index([reviewedById])
}

model DisposalItem {
  id                              String         @id @default(uuid()) @db.Uuid
  disposalRequestId               String         @db.Uuid
  equipmentId                     String         @db.Uuid
  quantity                        Int
  equipmentNameSnapshot           String?        @db.VarChar(160)
  physicalCondition               String?        @db.VarChar(500)
  functionality                   String?        @db.VarChar(500)
  photoUrl                        String?        @db.VarChar(2048)
  averageWeightGramsSnapshot      Int
  createdAt                       DateTime       @default(now()) @db.Timestamptz(6)
  disposalRequest                 DisposalRequest @relation(fields: [disposalRequestId], references: [id], onDelete: Restrict)
  equipment                       Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  divergence                      DisposalItemDivergence?

  @@unique([disposalRequestId, equipmentId])
  @@index([equipmentId])
}

model DisposalItemDivergence {
  id                         String       @id @default(uuid()) @db.Uuid
  disposalItemId             String       @unique @db.Uuid
  recordedById               String       @db.Uuid
  description                String       @db.VarChar(2000)
  quantityObserved           Int?
  physicalConditionObserved  String?      @db.VarChar(20)
  functionalityObserved      String?      @db.VarChar(40)
  createdAt                  DateTime     @default(now()) @db.Timestamptz(6)
  disposalItem               DisposalItem @relation(fields: [disposalItemId], references: [id], onDelete: Restrict)
  recordedBy                 User         @relation("DisposalDivergenceActor", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([recordedById])
}
model DisposalStatusHistory {
  id                 String          @id @default(uuid()) @db.Uuid
  disposalRequestId  String          @db.Uuid
  actorId            String?         @db.Uuid
  fromStatus         DisposalStatus?
  toStatus           DisposalStatus
  notes              String?         @db.VarChar(2000)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  disposalRequest    DisposalRequest @relation(fields: [disposalRequestId], references: [id], onDelete: Restrict)
  actor              User?           @relation("DisposalHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([disposalRequestId, createdAt])
  @@index([actorId])
}
model EcoCoinWallet {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @unique @db.Uuid
  balance     Decimal            @default(0) @db.Decimal(14, 2)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  movements   EcoCoinMovement[]
}

model EcoCoinMovement {
  id               String                @id @default(uuid()) @db.Uuid
  walletId         String                @db.Uuid
  type             EcoCoinMovementType
  amount           Decimal               @db.Decimal(14, 2)
  balanceAfter     Decimal               @db.Decimal(14, 2)
  coinValueBrlSnapshot Decimal?           @db.Decimal(6, 2)
  paymentId            String? @unique @db.Uuid
  payment              EcoCoinPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  redemptionKey        String?            @unique @db.Uuid
  redemptionValueBrl   Decimal?           @db.Decimal(14, 2)
  disposalRequestId String?              @unique @db.Uuid
  createdByUserId  String?               @db.Uuid
  description      String?               @db.VarChar(500)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  wallet           EcoCoinWallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  disposalRequest  DisposalRequest?      @relation(fields: [disposalRequestId], references: [id], onDelete: Restrict)
  createdBy        User?                 @relation("MovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([createdByUserId, createdAt])
}

model SystemSetting {
  id               String    @id @default(uuid()) @db.Uuid
  key              String    @unique @db.VarChar(120)
  value            Json      @db.JsonB
  description      String?   @db.VarChar(500)
  createdByUserId  String?   @db.Uuid
  updatedByUserId  String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)
  createdBy        User?     @relation("SettingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy        User?     @relation("SettingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
}


model EcoCoinPayment {
  id             String @id @default(uuid()) @db.Uuid
  idempotencyKey String @unique @db.Uuid
  studentId      String @db.Uuid
  recipientId    String @db.Uuid
  studentName    String @db.VarChar(160)
  recipientName  String @db.VarChar(160)
  amount         Decimal @db.Decimal(14, 2)
  valueBrl       Decimal @db.Decimal(15, 3)
  balanceAfter   Decimal @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  student        User @relation("PaymentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  recipient      User @relation("PaymentRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  movement       EcoCoinMovement?

  @@index([studentId, createdAt])
  @@index([recipientId, createdAt])
}