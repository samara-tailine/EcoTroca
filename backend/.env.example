# Copie para .env e substitua os placeholders. Nunca distribua o .env real.
DATABASE_URL=postgresql://ecotroca_app:change_me@localhost:5432/ecotroca_db?schema=public
PORT=3000
JWT_SECRET=replace_with_at_least_32_random_characters
FRONTEND_ORIGIN=http://localhost:5173
# development permite teste local HTTP. production exige HTTPS para cookies Google.
NODE_ENV=development
SWAGGER_ENABLED=false
# ID público do cliente OAuth Web. Vazio desabilita Google; não há Client Secret.
GOOGLE_CLIENT_ID=

# Domínios exatos separados por vírgula; sem @, wildcard ou subdomínio implícito.
ALLOWED_EMAIL_DOMAINS=alunos.ifsuldeminas.edu.br,ifsuldeminas.edu.br
# Somente NODE_ENV=development, banco e FRONTEND_ORIGIN locais. Nunca vale em produção.
ALLOW_LOCAL_TEST_EMAILS=false
# Defina antes de provisionar/redefinir ADMIN; não inclui credencial real.
ADMIN_EMAIL=administrador@ifsuldeminas.edu.br
